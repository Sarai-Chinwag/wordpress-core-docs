{
  "id": "wp-docs-plugin-poc",
  "remote_url": "https://github.com/chubes4/wp-docs.git",
  "remote_path": "../wp-content/plugins/wp-docs",
  "build_artifact": "dist/plugins/wp-docs.zip",
  "extract_command": "tmp=$(mktemp -d) && unzip -q {artifact} -d \"$tmp\" && cp -a \"$tmp/wp-docs/.\" . && rm -rf \"$tmp\" {artifact}",
  "extensions": {
    "wordpress": {}
  },
  "version_targets": [
    {
      "file": "plugins/wp-docs/wp-docs.php",
      "artifact_path": "wp-docs/wp-docs.php",
      "pattern": "Version:\\s*([0-9.]+)"
    }
  ],
  "scripts": {
    "build": [
      "mkdir -p dist/plugins && rm -f dist/plugins/wp-docs.zip && cd plugins && zip -qr ../dist/plugins/wp-docs.zip wp-docs"
    ],
    "test": [
      "npm test"
    ]
  }
}
